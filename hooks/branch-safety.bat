@echo off
:: <!-- Generated by Claude Agentic SDLC Workflow -->
:: Hook: Simple Branch Safety Guard for Windows

FOR /F "tokens=*" %%i IN ('git branch --show-current') DO SET CURRENT_BRANCH=%%i

if "%CURRENT_BRANCH%"=="main" (
  echo [ERROR] Direct execution on 'main' branch is strictly prohibited!
  exit /b 1
)

if "%CURRENT_BRANCH%"=="master" (
  echo [ERROR] Direct execution on 'master' branch is strictly prohibited!
  exit /b 1
)

echo [PASS] Branch safety verified. Current branch: %CURRENT_BRANCH%
exit /b 0